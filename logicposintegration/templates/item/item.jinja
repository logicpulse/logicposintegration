    </table> -->
    {% if item_prices %}
    <table class="table price-list-table" style="margin: 0">
        <thead>
            <tr>
                <th>{{ _("Lista") }}</th>
                <th>{{ _("Preço") }}</th>
                <!-- <th>{{ _("UOM") }}</th> -->
                <th>{{ _("Artigo de stock") }}</th>
                <th>{{ _("Venda") }}</th>
                <th>{{ _("Compra") }}</th>
            </tr>
        </thead>
        <tbody>
            {% for p in item_prices %}
            <tr>
                <td>{{ p.price_list }}</td>
                <td class="rate">
                    {{ frappe.format_value(p.price_list_rate) }}
                    {% if p.currency %}<small style="color: #8d99a6; font-weight: 400">{{ p.currency }}</small>{% endif %}
                </td>
                <!-- <td>{{ p.uom or doc.stock_uom }}</td> -->
                <td>{% if doc.is_stock_item %}<span class="text-success">✓ {{ _("Sim") }}</span>{% else %}{{ _("Não") }}{% endif %}</td>
                <td>{% if doc.is_sales_item %}<span class="text-success">✓ {{ _("Sim") }}</span>{% else %}{{ _("Não") }}{% endif %}</td>
                <td>{% if doc.is_purchase_item %}<span class="text-success">✓ {{ _("Sim") }}</span>{% else %}{{ _("Não") }}{% endif %}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% elif doc.standard_rate %}
    <table class="table price-list-table" style="margin: 0">
        <thead>
            <tr>
                <th>{{ _("Lista") }}</th>
                <th>{{ _("Preço") }}</th>
                <th>{{ _("UOM") }}</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>{{ _("Taxa padrão") }}</td>
                <td class="rate">
                    {{ frappe.format_value(doc.standard_rate, {"fieldtype": "Currency", "options": default_currency}) }}
                </td>
                <td>{{ doc.stock_uom }}</td>
            </tr>
        </tbody>
    </table>
    {% else %}
    <table class="table spec-table" style="margin: 0">
        <tbody>
            <tr>
                <th>{{ _("Preços") }}</th>
                <td style="color: #8d99a6">{{ _("Sem preços definidos") }}</td>
            </tr>
        </tbody>
    </table>
    {% endif %}
    
    {# ── Rodapé ── #}
    {# <table class="table" style="margin-top: 24px; border-top: solid 1px #d1d8dd">
