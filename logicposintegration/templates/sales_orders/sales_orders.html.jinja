{# <pre style="background:#f0f0f0;padding:10px;font-size:11px;overflow:auto">
{{ doc.as_dict() | tojson(indent=2) }}
</pre> #}
{% set links = frappe.get_all('Dynamic Link', filters={'link_doctype': 'Company', 'link_name': doc.company, 'parenttype': 'Address'}, fields=['parent']) %}
{% set company_address = frappe.db.get_value('Address', links[0].parent, ['address_line1', 'address_line2', 'city', 'state', 'country', 'email_id', 'phone'], as_dict=True) %}
{% set company = frappe.db.get_value("Company", doc.company, ["name", "country", "website", "phone_no", "email"], as_dict=1) %} 

{% set customer = frappe.db.get_value("Customer", doc.customer_name, ["name", "tax_id", "primary_address", "customer_primary_address", "first_name", "last_name"], as_dict=True) %}
{% set _cust_links = frappe.get_all('Dynamic Link', filters={'link_doctype': 'Customer', 'link_name': doc.customer_name, 'parenttype': 'Address'}, fields=['parent'], order_by='creation asc') %}
{% set _cust_addr_name = customer.customer_primary_address or (_cust_links[0].parent if _cust_links else None) %}
{% set customer_address = frappe.db.get_value('Address', _cust_addr_name, ['address_line1', 'address_line2', 'city', 'state', 'country', 'pincode', 'phone'], as_dict=True) if _cust_addr_name else None %}

{% set _contact_links = frappe.get_all('Dynamic Link', filters={'link_doctype': 'Customer', 'link_name': doc.customer_name, 'parenttype': 'Contact'}, fields=['parent'], order_by='creation asc') %}
{% set _contact_name = doc.contact_person or (_contact_links[0].parent if _contact_links else None) %}
{% set customer_contact = frappe.db.get_value('Contact', _contact_name, ['first_name', 'last_name', 'email_id'], as_dict=True) if _contact_name else None %}

{% set bank_account = frappe.db.get_value("Bank Account", {"company": doc.company}, ["bank", "iban"], as_dict=1) if doc.company else None %}
{% set ns = namespace(discount_total=0.0, sub_total=0.0, withholding_tax_total=0.0, iva_total=0.0) %}

<table class="table" style="margin-top: 0; border-bottom: solid 1px #d1d8dd">
    <tbody>
        <tr>
            <td style="width: 50%; border: 0">
                <table class="table" style="margin: 0">
                    <thead>
                        <tr>
                            <td style="border: 0; padding: 0 !important">
                                <h3 style="margin: 0">{{ doc.company[:-2] }} {{ company.country }}</h3>
                            </td>
                        </tr>
                        {% if company_address %}
                            <tr>
                                <td style="border: 0; padding: 0 !important">
                                    <small>{{ [company_address.address_line1, company_address.city, company_address.state ] | select | join(", ") }}</small>
                                </td>
                            </tr>
                        {% endif %}
                        {% if company.phone_no %}
                            <tr>
                                <td style="border: 0; padding: 0 !important">
                                    <small>Telefone: {{ company.phone_no }}</small>
                                </td>
                            </tr>
                        {% endif %}
                        {% if company_address.phone %}
                            <tr>
                                <td style="border: 0; padding: 0 !important">
                                    <small>Telemovel: {{ company_address.phone }}</small>
                                </td>
                            </tr>
                        {% endif %}
                        {% if company.email %}
                            <tr>
                                <td style="border: 0; padding: 0 !important">
                                    <small>Email: {{ company.email }}</small> 
                                </td>
                            </tr>
                        {% endif %} 
                        <tr>
                            <td style="border: 0; padding: 0 !important">
                                <small>
                                    Website:
                                    <a href="{{ company.website or 'https://www.logicpulse.com/pt/' }}"
                                       target="_blank"
                                       class="text-info">
                                        <strong>logicpulse.com </strong>
                                    </a>
                                </small>
                            </td>
                        </tr>
                    </thead>
                </table>
            </td>
            <td style="width: 50%; border: 0">
                <table class="table" style="margin: 0">
                    <thead>
                        <tr>
                            <td style="width: 30%; border: 0">
                                <img src="{{ frappe.db.get_value('Company', doc.company, 'company_logo') or 'https://www.logicpulse.com/images/thumbs/0002017.png' }}"
                                     alt="company-logo"
                                     height="80px"
                                     width="auto" />
                            </td>
                        </tr>
                    </thead>
                </table>
                <table class="table table-striped" style="margin: 0">
                    <tbody>
                        <tr>
                            <th class="text-center">{{ doc.select_print_heading or "Ordem de Venda" }}</th>
                        </tr>
                        <tr>
                            <td class="text-center">{{ doc.name | replace('SO', '') }}</td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </tbody>
</table>
<table class="table table-striped" style="margin-bottom: 0">
    <tbody>
        <tr>
            <th class="text-center" colspan="2" width="45%">
                <small>CLIENTE</small>
            </th>
            <th class="text-center" width="25%">
                <small>NIF</small>
            </th>
            <th class="text-center" width="15%">
                <small>DATA</small>
            </th>
            <th class="text-center" width="15%">
                <small>VALIDADE</small>
            </th>
        </tr>
        <tr>
            <td class="text-center" colspan="2">
                <small>{{ doc.customer_name }}</small>
            </td>
            <td class="text-center">
                <small>{{ customer.tax_id or "N/D" }}</small>
            </td>
            <td class="text-center">
                <small>{{ doc.get_formatted("transaction_date") }}</small>
            </td>
            <td class="text-center">
                <small>{{ doc.get_formatted("valid_till") }}</small>
            </td>
        </tr>
        <tr>
            <th class="text-center" width="15%">
                <small>CIDADE</small>
            </th>
            <th class="text-center" width="30%">
                <small>ENDEREÇO</small>
            </th>
            <th class="text-center" width="25%">
                <small>CONTACTO</small>
            </th>
            <th class="text-center" width="15%">
                <small>DESCONTO</small>
            </th>
            <th class="text-center" width="15%">
                <small>T. PAGO</small>
            </th>
        </tr>
        <tr>
            <td class="text-center">
                <small>{{ customer_address.state or "N/D" }}</small>
            </td>
            {% if customer_address %}
                <td class="text-center">
                    <small>{{ [customer_address.address_line1, customer_address.city] | select | join(", ") }}</small>
                </td>
            {% else %}
                <td class="text-center">
                    <small>N/D</small>
                </td>
            {% endif %} 
            {% set contact_name = customer_contact.first_name + " " + customer_contact.last_name if customer_contact.last_name else customer_contact.first_name or "N/D" %}
            <td class="text-center">
                <small>{{ contact_name }}</small>
            </td>  
            <td class="text-center">
                <small>{{ doc.get_formatted("additional_discount_percentage") }} %</small>
            </td>
            <td class="text-center">
                <small>{{ frappe.db.get_value("Payment Terms Template",
                doc.payment_terms_template,"template_name") or "CONTADO" }}</small>
            </td>
        </tr>
    </tbody>
</table>
<table class="table">
    <tbody>
        <tr>
            <td colspan="9" class="text-left">
                <small>
                    <strong>Moeda:</strong>{{ frappe.db.get_value("Currency", doc.currency, "currency_name") }} |
                    <strong>Banco:</strong>{{ bank_account.bank if bank_account else "N/D" }} |
                    {# <strong>IBAN: </strong>{{ bank_account.iban|regex_replace('(.{4})(?=.)', '\1 ') if bank_account else "N/D" }} #}
                    <strong>IBAN:</strong>
                    {% if bank_account and bank_account.iban %}
                        {% set clean_iban = bank_account.iban.replace(' ', '') %}
                        {{ clean_iban | batch(4) | map('join', '') | join(' ') }}
                    {% else %}
                        N/D
                    {% endif %}
                </small>
            </td>
        </tr>
        <tr>
            <th class="text-center">
                <small>CÓDIGO</small>
            </th>
            <th class="text-center">
                <small>DESCRIÇÃO</small>
            </th>
            <th class="text-center">
                <small>IMG</small>
            </th>
            <th class="text-center">
                <small>QTD</small>
            </th>
            <th class="text-center">
                <small>PREÇO</small>
            </th>
            <th class="text-center">
                <small>DCT(%)</small>
            </th>
            <th class="text-center">
                <small>TOTAL</small>
            </th>
            <th class="text-center">
                <small>IVA</small>
            </th>
            <th class="text-center">
                <small>TOTAL C/ IVA</small>
            </th>
        </tr>
        {% set sorted_items = doc.items|sort(attribute='item_group', case_sensitive=False) %}
        {% set ns_group = namespace(prev=None) %}
        {%- for row in sorted_items -%}
            {% set grp_key = row.item_group or "" %}
            {% if grp_key != ns_group.prev %}
                <tr>
                    <td colspan="9" style="background-color: #f0f4f7; border-top: 2px solid #d1d8dd; padding: 6px 8px">
                        <strong><small>{{ row.item_group or "Sem grupo" }}</small></strong>
                    </td>
                </tr>
                {% set ns_group.prev = grp_key %}
            {% endif %}
            {% set withholding_tax = 0.065 %} 
            {% set rate_sem_desconto = row.price_list_rate %} 
            {% set line_discount = (rate_sem_desconto * row.qty) * (row.discount_percentage / 100) if row.discount_percentage else 0 %}
            {% set ns.discount_total = ns.discount_total + line_discount %}
            {% set line_sub_total = row.rate * row.qty %} 
            {% set line_total = line_sub_total  %}
            {% set line_iva = (line_total * (doc.taxes[0].rate / 100) if doc.taxes else 0) %}
            {% set line_total_w_iva = line_total + line_iva %}
            {% set ns.sub_total = ns.sub_total + line_total %}
            {% set ns.iva_total = ns.iva_total + line_iva %} 
            {% set item_group = (row.item_group or "") | lower | replace("ç", "c") %}
            {% set line_withholding_tax = line_total * withholding_tax if "servicos" in item_group else 0 %}
            {# {% set line_withholding_tax = line_total * withholding_tax if row.item_group and "serviços" in row.item_group|lower else 0 %} #}
            {% set ns.withholding_tax_total = ns.withholding_tax_total + line_withholding_tax %}
            {% set url = frappe.db.get_value("Item", row.item_code, "url") %}
            <tr>
                <td style="width: 6%">
                    <strong>
                        <small>
                            <a href="{{ url }}" target="_blank">{{ row.item_code }}</a>
                        </small>
                    </strong>
                    {% if line_withholding_tax != 0 %}
                        <p style="font-size: 0.6em; font-style: italic; margin-bottom: 0;">(C/ Retenção na Fonte)</p>
                    {% endif %}
                </td>
                <td style="width: 25%">
                    <small>
                        <div class="col-12">{{ row.item_name }}</div>
                    </small>
                </td>
                <td style="width: 12%" class="text-center">
                    {% if row.image %}
                        <img src="{{ row.image }}"
                             alt="{{ row.item_name }}"
                             width="42"
                             height="42"
                             style="vertical-align: middle"
                             onerror=" this.style.display = 'none'; this.parentNode.innerHTML = '<small>N/D</small>'; " />
                        {% else %}
                            <small>N/D</small>
                        {% endif %}
                    </td>
                    <td style="width: 7%; text-align: right">
                        <small>{{ row.qty }} {{ row.uom or row.stock_uom }}</small>
                    </td>
                    <td style="width: 12%; text-align: right">
                        {# <small>{{ row.get_formatted("price_list_rate", doc) }}</small> #}
                        <small>{{ frappe.utils.fmt_money(rate_sem_desconto) }}</small>
                    </td>
                    <td style="width: 7%; text-align: right">
                        <small>{{ row.discount_percentage }}%</small>
                    </td>
                    <td style="width: 12%; text-align: right">
                        {# <small>{{ frappe.utils.fmt_money(row.amount, currency=doc.currency) }}</small> #}
                        <small>{{ frappe.utils.fmt_money(line_total) }}</small>
                    </td>
                    <td style="width: 7%; text-align: right">
                        <small>{{ doc.taxes[0].rate if doc.taxes else 0 }}%</small>
                    </td>
                    <td style="width: 12%; text-align: right">
                        {# <small>{{ frappe.utils.fmt_money(row.amount + iva, currency=doc.currency) }}</small> #}
                        <small>{{ frappe.utils.fmt_money(line_total_w_iva) }}</small>
                    </td>
                </tr>
                {% if row.description and row.description|striptags|trim != "" and row.description|striptags != row.item_name %}
                    <tr>
                        <td colspan="9" style="border-top: none" class="text-left">
                            <small style="font-size: 0.6em;"><strong>Nota:</strong> {{ row.description|striptags|trim }}</small>
                        </td>
                    </tr>
                {% endif %}
            {%- endfor -%}
            {# <tr>
                <td colspan="7" class="text-right">
                    <strong>SUB-TOTAL</strong>
                </td>
                <td class="text-right" colspan="2"> 
                    <small>{{ frappe.utils.fmt_money(ns.sub_total, currency=doc.currency) }}</small>
                </td>
            </tr> #} 
            <tr>
                {% set ns.discount_total = ns.discount_total + doc.discount_amount %}
                <td colspan="7" class="text-right">
                    <strong>TOTAL DE DESCONTOS</strong>
                </td>
                <td class="text-right" colspan="2">
                    <small>{{ frappe.utils.fmt_money(ns.discount_total, currency=doc.currency) }}</small>
                </td>
            </tr>
            <tr>
                {% set net_total = ns.sub_total %}
                <td colspan="7" class="text-right">
                    <strong>TOTAL LÍQUIDO</strong>
                </td>
                <td class="text-right" colspan="2"> 
                    <small>{{ frappe.utils.fmt_money(net_total, currency=doc.currency) }}</small>
                </td>
            </tr>
            {% if doc.taxes %}
                <tr>
                    <td colspan="7" class="text-right"> 
                        <strong>TOTAL IMPOSTO</strong>
                    </td>
                    <td class="text-right" colspan="2">
                        <small>{{ frappe.utils.fmt_money(ns.iva_total, currency=doc.currency) }}</small>
                    </td>
                </tr>
            {% endif %}
            {# IVA #}
            {# {%- for row in doc.taxes -%}
                <tr>
                    <td colspan="7" class="text-right">
                        <strong>TOTAL {{ row.description }}</strong>
                    </td>
                    <td class="text-right" colspan="2">
                        <small>{{ row.get_formatted("tax_amount", doc) }}</small>
                    </td>
                </tr>
            {%- endfor -%} #}
            <tr>
                <td colspan="7" class="text-right">
                    <strong>RETENÇÂO NA FONTE</strong>
                </td>
                <td class="text-right" colspan="2">
                    <small>{{ frappe.utils.fmt_money(ns.withholding_tax_total, currency=doc.currency) }}</small>
                </td>
            </tr>
            <tr>
                <td colspan="7" class="text-right">
                    <strong>TOTAL</strong>
                </td>
                <td class="text-right" colspan="2">
                    {% set grand_total = net_total + ns.iva_total %}
                    <strong><small>{{ frappe.utils.fmt_money(grand_total, currency=doc.currency) }}</small></strong>
                </td> 
            </tr>
            <tr>
                {# {% set in_word = doc.in_words.split(" ", 1) %} #}
                {% set in_words = frappe.utils.money_in_words(grand_total, doc.currency) %}
                {% set parts = in_words.split(" ", 1) %}
                {% set moeda = parts[0] %}
                {% set valor = parts[1] | lower | replace("apenas.", "") | replace(" apenas", "") | replace(" only.", "") | replace("and", "kzs e") | replace(" somente.", "") %}
                <td colspan="9" class="text-right">
                    <strong><small>Por extenso: {{ moeda }} {{ valor | capitalize }}.</small></strong>
                    {# <strong><small>Por extenso: {{ frappe.utils.money_in_words(grand_total, doc.currency) }}.</small></strong> #}
                </td>
            </tr>
        </tbody>
    </table>
    {% if doc.terms %}
        <div class="panel panel-default">
            <div class="panel-heading">
                <strong><small>Termos e Condições</small></strong>
            </div>
            <div class="panel-body">
                <small>{{ doc.terms }}</small>
            </div>
        </div>
    {% endif %}
    <div class="footer-final">
        <hr />
        <div class="text-center">
            <small>Este documento não serve de fatura</small>
        </div>
    </div>
    {# price_list_rate - A exibição depende de (JS) - margin_type #}
    {# price_list_rate - A exibição depende de (JS) - Discount amount #}
